{
  "name": "Math2Music",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Math2Music Trunk",
      "onAutoForward": "openBrowser"
    }
  },
  "onCreateCommand": "rustup target add wasm32-unknown-unknown && cargo install trunk --locked",
  "postCreateCommand": "rustup target add wasm32-unknown-unknown"
}
